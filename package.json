{
  "name": "jobprepassistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI Interview Prep Kit — Turn a job description into a personalised interview preparation kit",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
