# ===========================================
# AI Interview Prep Kit — Environment Variables
# ===========================================

# --- MongoDB ---
# Connection string for MongoDB. Use MongoDB Atlas free tier for production.
MONGODB_URI=mongodb://localhost:27017/jobprepassistant

# --- JWT Authentication ---
# Secret key for signing JWT tokens. Use a long, random string.
JWT_SECRET=your-secret-key-change-this-in-production

# --- LLM Provider (Google Gemini) ---
# API key from Google AI Studio (https://aistudio.google.com/apikey)
# Free tier: 10 RPM, 250K TPM, 1500 RPD
GEMINI_API_KEY=your-gemini-api-key

# Model to use (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# --- Server ---
# Port for the Express API server
API_PORT=3001

# URL of the frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# --- Frontend ---
# URL of the backend API (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Environment ---
# Set to 'production' in deployment
NODE_ENV=development
